# ============================================================
# Terraform
# ============================================================

# Terraform working directory
.terraform/

# Terraform state files
*.tfstate
*.tfstate.*
terraform.tfstate
terraform.tfstate.*

# Terraform variable files containing environment-specific values
*.tfvars
*.tfvars.json

# Allow example variable files
!*.tfvars.example

# Terraform crash logs
crash.log
crash.*.log

# Terraform plan files
*.tfplan
*.plan

# Terraform override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Terraform CLI configuration
.terraformrc
terraform.rc


# ============================================================
